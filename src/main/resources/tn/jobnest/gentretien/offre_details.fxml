<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.jobnest.gentretien.controller.OffreDetailsController"
      prefWidth="680" prefHeight="820"
      style="-fx-background-color: white;">

    <!-- HEADER -->
    <VBox style="-fx-background-color: #1E3A5F; -fx-padding: 22 28 18 28;" spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="14">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label fx:id="titreLabel" text="—" wrapText="true"
                       style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                <Label fx:id="statutBadgeLabel" text="● Ouvert"
                       style="-fx-background-color:#DCFCE7; -fx-text-fill:#16A34A;
                              -fx-font-size:12px; -fx-font-weight:bold;
                              -fx-background-radius:20; -fx-padding:4 12 4 12;"/>
            </VBox>
            <Button text="✕" onAction="#closePopup"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                           -fx-text-fill: white; -fx-font-size: 15px;
                           -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 4 10 4 10;"/>
        </HBox>
    </VBox>
    <Region prefHeight="4"
            style="-fx-background-color: linear-gradient(to right, #F97316, #2563EB);"/>

    <!-- BODY -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #F5F7FB; -fx-background: #F5F7FB; -fx-border-color: transparent;">
        <VBox spacing="14" style="-fx-background-color: #F5F7FB; -fx-padding: 20 22 14 22;">

            <!-- Informations générales -->
            <VBox spacing="12"
                  style="-fx-background-color:white; -fx-padding:16;
                         -fx-background-radius:12; -fx-border-color:#E8EFF8;
                         -fx-border-width:1; -fx-border-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(30,58,95,0.07),10,0,0,3);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region prefWidth="3" prefHeight="16"
                            style="-fx-background-color:#2563EB; -fx-background-radius:2;"/>
                    <Label text="INFORMATIONS GÉNÉRALES"
                           style="-fx-font-size:10px; -fx-font-weight:800; -fx-text-fill:#94A3B8;"/>
                </HBox>
                <GridPane hgap="16" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="160"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <HBox spacing="6" alignment="CENTER_LEFT"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="🏢" style="-fx-font-size:13px;"/>
                        <Label text="Entreprise"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#64748B;"/>
                    </HBox>
                    <Label fx:id="entrepriseLabel" text="—"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"
                           style="-fx-font-size:13px; -fx-font-weight:600; -fx-text-fill:#1E3A5F;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT"
                          GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="📄" style="-fx-font-size:13px;"/>
                        <Label text="Type de contrat"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#64748B;"/>
                    </HBox>
                    <Label fx:id="contratLabel" text="—"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"
                           style="-fx-font-size:13px; -fx-font-weight:600; -fx-text-fill:#1E3A5F;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT"
                          GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="👥" style="-fx-font-size:13px;"/>
                        <Label text="Postes disponibles"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#64748B;"/>
                    </HBox>
                    <Label fx:id="nbPostesLabel" text="—"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"
                           style="-fx-font-size:13px; -fx-font-weight:600; -fx-text-fill:#1E3A5F;"/>
                </GridPane>
            </VBox>

            <!-- Rémunération -->
            <VBox spacing="10"
                  style="-fx-background-color:white; -fx-padding:16;
                         -fx-background-radius:12; -fx-border-color:#E8EFF8;
                         -fx-border-width:1; -fx-border-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(30,58,95,0.07),10,0,0,3);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region prefWidth="3" prefHeight="16"
                            style="-fx-background-color:#059669; -fx-background-radius:2;"/>
                    <Label text="RÉMUNÉRATION"
                           style="-fx-font-size:10px; -fx-font-weight:800; -fx-text-fill:#94A3B8;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="💰" style="-fx-font-size:16px;"/>
                    <Label fx:id="salaireLabel" text="—"
                           style="-fx-font-size:15px; -fx-font-weight:800; -fx-text-fill:#059669;
                                  -fx-background-color:#D1FAE5; -fx-background-radius:8;
                                  -fx-padding:6 14 6 14;"/>
                </HBox>
            </VBox>

            <!-- Dates -->
            <VBox spacing="10"
                  style="-fx-background-color:white; -fx-padding:16;
                         -fx-background-radius:12; -fx-border-color:#E8EFF8;
                         -fx-border-width:1; -fx-border-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(30,58,95,0.07),10,0,0,3);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region prefWidth="3" prefHeight="16"
                            style="-fx-background-color:#F97316; -fx-background-radius:2;"/>
                    <Label text="DATES" style="-fx-font-size:10px; -fx-font-weight:800; -fx-text-fill:#94A3B8;"/>
                </HBox>
                <HBox spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:#F8FAFC; -fx-padding:12 14 12 14;
                                 -fx-background-radius:10; -fx-border-color:#E2E8F0;
                                 -fx-border-width:1; -fx-border-radius:10;">
                        <Label text="📅  DATE DE PUBLICATION"
                               style="-fx-font-size:9px; -fx-font-weight:800; -fx-text-fill:#94A3B8;"/>
                        <Label fx:id="publicationLabel" text="—"
                               style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#1E3A5F;"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:#FFF7ED; -fx-padding:12 14 12 14;
                                 -fx-background-radius:10; -fx-border-color:#FED7AA;
                                 -fx-border-width:1; -fx-border-radius:10;">
                        <Label text="⏳  DATE D'EXPIRATION"
                               style="-fx-font-size:9px; -fx-font-weight:800; -fx-text-fill:#F97316;"/>
                        <Label fx:id="expirationLabel" text="—"
                               style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#C2410C;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Description -->
            <VBox spacing="10"
                  style="-fx-background-color:white; -fx-padding:16;
                         -fx-background-radius:12; -fx-border-color:#E8EFF8;
                         -fx-border-width:1; -fx-border-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(30,58,95,0.07),10,0,0,3);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region prefWidth="3" prefHeight="16"
                            style="-fx-background-color:#7C3AED; -fx-background-radius:2;"/>
                    <Label text="DESCRIPTION DU POSTE"
                           style="-fx-font-size:10px; -fx-font-weight:800; -fx-text-fill:#94A3B8;"/>
                </HBox>
                <Label fx:id="descriptionLabel" wrapText="true"
                       style="-fx-text-fill:#374151; -fx-font-size:13px; -fx-line-spacing:4;"/>
            </VBox>

            <!-- Compétences -->
            <VBox spacing="10"
                  style="-fx-background-color:white; -fx-padding:16;
                         -fx-background-radius:12; -fx-border-color:#E8EFF8;
                         -fx-border-width:1; -fx-border-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(30,58,95,0.07),10,0,0,3);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region prefWidth="3" prefHeight="16"
                            style="-fx-background-color:#2563EB; -fx-background-radius:2;"/>
                    <Label text="🔧  COMPÉTENCES REQUISES"
                           style="-fx-font-size:10px; -fx-font-weight:800; -fx-text-fill:#94A3B8;"/>
                </HBox>
                <FlowPane fx:id="competencesPane" hgap="8" vgap="8"
                          style="-fx-background-color:transparent;"/>
            </VBox>

            <!-- Expériences -->
            <VBox spacing="10"
                  style="-fx-background-color:white; -fx-padding:16;
                         -fx-background-radius:12; -fx-border-color:#E8EFF8;
                         -fx-border-width:1; -fx-border-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(30,58,95,0.07),10,0,0,3);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region prefWidth="3" prefHeight="16"
                            style="-fx-background-color:#059669; -fx-background-radius:2;"/>
                    <Label text="📋  EXPÉRIENCES REQUISES"
                           style="-fx-font-size:10px; -fx-font-weight:800; -fx-text-fill:#94A3B8;"/>
                </HBox>
                <FlowPane fx:id="experiencesPane" hgap="8" vgap="8"
                          style="-fx-background-color:transparent;"/>
            </VBox>

            <!-- Statistiques -->
            <VBox spacing="10"
                  style="-fx-background-color:white; -fx-padding:16;
                         -fx-background-radius:12; -fx-border-color:#E8EFF8;
                         -fx-border-width:1; -fx-border-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(30,58,95,0.07),10,0,0,3);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region prefWidth="3" prefHeight="16"
                            style="-fx-background-color:#0EA5E9; -fx-background-radius:2;"/>
                    <Label text="STATISTIQUES DE L'OFFRE"
                           style="-fx-font-size:10px; -fx-font-weight:800; -fx-text-fill:#94A3B8;"/>
                </HBox>
                <HBox spacing="14">
                    <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:#F0F9FF; -fx-padding:12 0 12 0;
                                 -fx-background-radius:10; -fx-border-color:#BAE6FD;
                                 -fx-border-width:1; -fx-border-radius:10;">
                        <Label text="👁" style="-fx-font-size:18px;"/>
                        <Label fx:id="nbVuesLabel" text="0"
                               style="-fx-font-size:22px; -fx-font-weight:800; -fx-text-fill:#0284C7;"/>
                        <Label text="Vues"
                               style="-fx-font-size:11px; -fx-text-fill:#64748B; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:#FFF7ED; -fx-padding:12 0 12 0;
                                 -fx-background-radius:10; -fx-border-color:#FED7AA;
                                 -fx-border-width:1; -fx-border-radius:10;">
                        <Label text="📩" style="-fx-font-size:18px;"/>
                        <Label fx:id="nbCandidaturesLabel" text="0"
                               style="-fx-font-size:22px; -fx-font-weight:800; -fx-text-fill:#C2410C;"/>
                        <Label text="Candidatures"
                               style="-fx-font-size:11px; -fx-text-fill:#64748B; -fx-font-weight:bold;"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- FOOTER avec boutons action -->
    <VBox style="-fx-background-color: white;
                 -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;
                 -fx-padding: 14 22 18 22;" spacing="10">

        <!-- ✅ Bouton Fermer l'offre (visible si ouverte) -->
        <Button fx:id="fermerBtn"
                text="🔒  Fermer l'offre"
                onAction="#handleFermerOffre"
                prefHeight="44" prefWidth="636"
                style="-fx-background-color:#FFF7ED; -fx-text-fill:#C2410C;
                       -fx-font-weight:bold; -fx-font-size:13px;
                       -fx-border-color:#FED7AA; -fx-border-width:1.5;
                       -fx-border-radius:10; -fx-background-radius:10; -fx-cursor:hand;"/>

        <!-- ✅ Bouton Republier (visible si fermée) -->
        <Button fx:id="republierBtn"
                text="🔄  Republier l'offre"
                onAction="#handleRepublierOffre"
                prefHeight="44" prefWidth="636"
                visible="false" managed="false"
                style="-fx-background-color:#F0FDF4; -fx-text-fill:#15803D;
                       -fx-font-weight:bold; -fx-font-size:13px;
                       -fx-border-color:#86EFAC; -fx-border-width:1.5;
                       -fx-border-radius:10; -fx-background-radius:10; -fx-cursor:hand;"/>

        <!-- Bouton fermer la fenêtre -->
        <Button text="✕  Fermer"
                onAction="#closePopup"
                prefHeight="44" prefWidth="636"
                style="-fx-background-color: #1E3A5F; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: 800;
                       -fx-background-radius: 12px; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(30,58,95,0.35), 10, 0, 0, 4);"/>
    </VBox>

</VBox>
