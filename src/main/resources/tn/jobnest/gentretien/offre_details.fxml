<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="18"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.jobnest.gentretien.controller.OffreDetailsController">

    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

    <Label fx:id="titreLabel"
           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#1e3a8a;"/>

    <VBox spacing="10"
          style="-fx-background-color:white; -fx-padding:15; -fx-background-radius:10;
                 -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,3);">

        <GridPane hgap="12" vgap="10">
            <Label text="Entreprise :" style="-fx-font-weight:bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="entrepriseLabel"                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Contrat :"    style="-fx-font-weight:bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="contratLabel"                                 GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Expérience :" style="-fx-font-weight:bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="experienceLabel"                              GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Salaire :"    style="-fx-font-weight:bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Label fx:id="salaireLabel"                                 GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Postes :"     style="-fx-font-weight:bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label fx:id="postesLabel"                                  GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Publication :" style="-fx-font-weight:bold;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <Label fx:id="publicationLabel"                              GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Expiration :" style="-fx-font-weight:bold;" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <Label fx:id="expirationLabel"                              GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        </GridPane>
    </VBox>

    <VBox spacing="6">
        <Label text="Description" style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#374151;"/>
        <Label fx:id="descriptionLabel" wrapText="true"
               style="-fx-text-fill:#4b5563; -fx-font-size:13px;"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Fermer" onAction="#closePopup"
                prefWidth="120" prefHeight="36"
                style="-fx-background-color:#ef4444; -fx-text-fill:white;
                       -fx-font-weight:bold; -fx-background-radius:8px; -fx-cursor:hand;"/>
    </HBox>
</VBox>
