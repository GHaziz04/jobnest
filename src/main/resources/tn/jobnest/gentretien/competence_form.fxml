<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.jobnest.gentretien.controller.CompetenceFormController"
      prefWidth="380">

    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- HEADER -->
    <Label text="➕  Nouvelle Compétence"
           style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#1E3A5F;"/>

    <Separator/>

    <!-- Nom -->
    <VBox spacing="5">
        <Label text="Nom de la compétence *"
               style="-fx-font-weight:bold; -fx-text-fill:#374151; -fx-font-size:12px;"/>
        <TextField fx:id="nomField"
                   promptText="Ex: Java, React, Docker..."
                   style="-fx-background-color:white; -fx-border-color:#E2E8F0;
                          -fx-border-width:1.5; -fx-border-radius:8;
                          -fx-background-radius:8; -fx-padding:8 12 8 12;
                          -fx-font-size:13px;"/>
    </VBox>

    <!-- Catégorie -->
    <VBox spacing="5">
        <Label text="Catégorie *"
               style="-fx-font-weight:bold; -fx-text-fill:#374151; -fx-font-size:12px;"/>
        <ComboBox fx:id="categorieCombo"
                  prefWidth="335"
                  promptText="Choisir une catégorie"
                  style="-fx-background-color:white; -fx-border-color:#E2E8F0;
                         -fx-border-width:1.5; -fx-border-radius:8;
                         -fx-background-radius:8; -fx-font-size:13px;
                         -fx-padding:4 10 4 10;"/>
    </VBox>

    <!-- Niveau -->
    <VBox spacing="5">
        <Label text="Niveau requis *"
               style="-fx-font-weight:bold; -fx-text-fill:#374151; -fx-font-size:12px;"/>
        <ComboBox fx:id="niveauCombo"
                  prefWidth="335"
                  promptText="Choisir un niveau"
                  style="-fx-background-color:white; -fx-border-color:#E2E8F0;
                         -fx-border-width:1.5; -fx-border-radius:8;
                         -fx-background-radius:8; -fx-font-size:13px;
                         -fx-padding:4 10 4 10;"/>
    </VBox>

    <!-- Description -->
    <VBox spacing="5">
        <Label text="Description *"
               style="-fx-font-weight:bold; -fx-text-fill:#374151; -fx-font-size:12px;"/>
        <TextArea fx:id="descriptionField"
                  promptText="Décrivez cette compétence..."
                  prefRowCount="4"
                  wrapText="true"
                  style="-fx-background-color:white; -fx-border-color:#E2E8F0;
                         -fx-border-width:1.5; -fx-border-radius:8;
                         -fx-background-radius:8; -fx-font-size:13px;
                         -fx-padding:8 12 8 12;"/>
    </VBox>

    <Separator/>

    <!-- Bouton Enregistrer -->
    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnSave"
                text="Enregistrer"
                onAction="#save"
                prefWidth="180" prefHeight="40"
                style="-fx-background-color:#1E3A5F; -fx-text-fill:white;
                       -fx-font-weight:bold; -fx-font-size:13px;
                       -fx-background-radius:10; -fx-cursor:hand;
                       -fx-effect:dropshadow(gaussian,rgba(30,58,95,0.35),10,0,0,3);"/>
    </HBox>

</VBox>
