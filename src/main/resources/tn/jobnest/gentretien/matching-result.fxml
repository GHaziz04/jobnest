<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<!--
    matching-result.fxml
    Layout minimaliste : tout le design est construit dynamiquement
    dans MatchingResultController#afficherResultat() pour reproduire
    fidèlement le style dark premium (identique à la preview HTML).
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.jobnest.gentretien.controller.MatchingResultController"
      fx:id="rootVBox"
      prefWidth="860"
      style="-fx-background-color:#0F1623;"/>
