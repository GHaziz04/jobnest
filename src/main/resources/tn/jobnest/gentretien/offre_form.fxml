<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.jobnest.gentretien.controller.OffreFormController"
            style="-fx-background: #F5F7FB; -fx-background-color: #F5F7FB; -fx-border-color: transparent;"
            prefWidth="700" prefHeight="800">

    <content>
        <VBox spacing="0"
              style="-fx-background-color: #F5F7FB;"
              fillWidth="true">

            <!-- ══════════════════════════════ HEADER ══════════════════════════════ -->
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #1E3A5F;
                         -fx-padding: 20 24 20 24;">
                <Label text="💼  Créer une Nouvelle Offre"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#closePopup"
                        style="-fx-background-color: rgba(255,255,255,0.15);
                               -fx-text-fill: white; -fx-font-size: 15px;
                               -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-padding: 4 10 4 10;"/>
            </HBox>

            <!-- ══════════════════════════════ BODY ══════════════════════════════ -->
            <VBox spacing="16"
                  style="-fx-padding: 24 28 24 28; -fx-background-color: #F5F7FB;">

                <!-- ── Ligne 1 : Titre + Entreprise ── -->
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Titre du Poste *"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#374151;"/>
                        <TextField fx:id="titreField"
                                   promptText="Ex: Développeur Full Stack Java"
                                   style="-fx-background-color:white; -fx-border-color:#E2E8F0;
                                          -fx-border-width:1.5; -fx-border-radius:9;
                                          -fx-background-radius:9; -fx-padding:9 12 9 12;
                                          -fx-font-size:13px;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Entreprise *"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#374151;"/>
                        <TextField fx:id="entrepriseField"
                                   promptText="Nom de l'entreprise"
                                   style="-fx-background-color:white; -fx-border-color:#E2E8F0;
                                          -fx-border-width:1.5; -fx-border-radius:9;
                                          -fx-background-radius:9; -fx-padding:9 12 9 12;
                                          -fx-font-size:13px;"/>
                    </VBox>
                </HBox>

                <!-- ── Ligne 2 : Contrat + Salaire ── -->
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Type de Contrat *"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#374151;"/>
                        <ComboBox fx:id="contratBox"
                                  promptText="Choisir..."
                                  maxWidth="Infinity"
                                  style="-fx-background-color:white; -fx-border-color:#E2E8F0;
                                         -fx-border-width:1.5; -fx-border-radius:9;
                                         -fx-background-radius:9; -fx-font-size:13px;
                                         -fx-padding:4 10 4 10;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Salaire (DT) *"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#374151;"/>
                        <TextField fx:id="salaireField"
                                   promptText="Ex: 1500"
                                   style="-fx-background-color:white; -fx-border-color:#E2E8F0;
                                          -fx-border-width:1.5; -fx-border-radius:9;
                                          -fx-background-radius:9; -fx-padding:9 12 9 12;
                                          -fx-font-size:13px;"/>
                    </VBox>
                </HBox>

                <!-- ── Description ── -->
                <VBox spacing="6">
                    <Label text="Description du Poste *"
                           style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#374151;"/>
                    <TextArea fx:id="descriptionField"
                              prefRowCount="5"
                              wrapText="true"
                              promptText="Décrivez le poste, les responsabilités, le profil recherché..."
                              style="-fx-background-color:white; -fx-border-color:#E2E8F0;
                                     -fx-border-width:1.5; -fx-border-radius:9;
                                     -fx-background-radius:9; -fx-font-size:13px;
                                     -fx-padding:9 12 9 12;"/>
                </VBox>

                <!-- ── Bouton IA ── -->
                <HBox>
                    <Button text="✨  Suggest Skills (IA)"
                            onAction="#suggestSkillsAI"
                            prefHeight="40"
                            style="-fx-background-color: #7C3AED;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 13px;
                                   -fx-background-radius: 10;
                                   -fx-cursor: hand;
                                   -fx-padding: 0 20 0 20;
                                   -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.35), 10, 0, 0, 3);"/>
                </HBox>

                <!-- ── Séparateur ── -->
                <Separator style="-fx-background-color:#E2E8F0;"/>

                <!-- ── Compétences ── -->
                <VBox spacing="8"
                      style="-fx-background-color:white; -fx-padding:16;
                             -fx-background-radius:12;
                             -fx-border-color:#E8EFF8; -fx-border-width:1;
                             -fx-border-radius:12;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🔧  Compétences requises"
                               style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#1E3A5F;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="＋  Ajouter Compétence"
                                onAction="#handleAddCompetence"
                                prefHeight="34"
                                style="-fx-background-color:#2563EB; -fx-text-fill:white;
                                       -fx-font-weight:bold; -fx-font-size:12px;
                                       -fx-background-radius:8; -fx-cursor:hand;
                                       -fx-padding:0 14 0 14;"/>
                    </HBox>
                    <ListView fx:id="competencesList"
                              prefHeight="150"
                              style="-fx-background-color:#F8FAFC;
                                     -fx-border-color:#E2E8F0;
                                     -fx-border-width:1;
                                     -fx-border-radius:8;
                                     -fx-background-radius:8;"/>
                </VBox>

                <!-- ── Expériences ── -->
                <VBox spacing="8"
                      style="-fx-background-color:white; -fx-padding:16;
                             -fx-background-radius:12;
                             -fx-border-color:#E8EFF8; -fx-border-width:1;
                             -fx-border-radius:12;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📋  Expériences requises"
                               style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#1E3A5F;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="＋  Ajouter Expérience"
                                onAction="#handleAddExperience"
                                prefHeight="34"
                                style="-fx-background-color:#059669; -fx-text-fill:white;
                                       -fx-font-weight:bold; -fx-font-size:12px;
                                       -fx-background-radius:8; -fx-cursor:hand;
                                       -fx-padding:0 14 0 14;"/>
                    </HBox>
                    <ListView fx:id="experiencesList"
                              prefHeight="130"
                              style="-fx-background-color:#F8FAFC;
                                     -fx-border-color:#E2E8F0;
                                     -fx-border-width:1;
                                     -fx-border-radius:8;
                                     -fx-background-radius:8;"/>
                </VBox>

                <!-- ── Séparateur ── -->
                <Separator style="-fx-background-color:#E2E8F0;"/>

                <!-- ── Bouton Publier ── -->
                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Button text="Annuler" onAction="#closePopup"
                            prefHeight="42" prefWidth="130"
                            style="-fx-background-color:white;
                                   -fx-text-fill:#64748B;
                                   -fx-border-color:#E2E8F0;
                                   -fx-border-width:1.5;
                                   -fx-border-radius:10;
                                   -fx-background-radius:10;
                                   -fx-font-weight:bold;
                                   -fx-cursor:hand;"/>
                    <Button text="🚀  Publier l'Offre"
                            onAction="#ajouter"
                            prefHeight="42" prefWidth="200"
                            style="-fx-background-color: #059669;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 10;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(5,150,105,0.4), 10, 0, 0, 3);"/>
                </HBox>

            </VBox>
        </VBox>
    </content>
</ScrollPane>
