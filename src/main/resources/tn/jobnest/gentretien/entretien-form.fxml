<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.jobnest.gentretien.controller.EntretienFormController"
      spacing="0" prefWidth="540" prefHeight="800"
      style="-fx-background-color: white;">

    <!-- HEADER BLEU -->
    <VBox style="-fx-background-color: #1E3A5F; -fx-padding: 22 35 18 35;" spacing="4">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="Planifier un Entretien"
                       style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                <Label text="Remplissez les informations de l'entretien"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.6);"/>
            </VBox>
        </HBox>

        <!-- Bandeau dynamique : candidat + offre (rempli par le contrôleur) -->
        <HBox spacing="24" alignment="CENTER_LEFT"
              style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 8;
                     -fx-padding: 10 16 10 16; -fx-margin: 8 0 0 0;">
            <VBox spacing="2">
                <Label text="CANDIDAT"
                       style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-weight: 700;"/>
                <Label fx:id="lblInfoCandidat" text="—"
                       style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: 700;"/>
            </VBox>
            <Label text="│" style="-fx-text-fill: rgba(255,255,255,0.3); -fx-font-size: 18px;"/>
            <VBox spacing="2">
                <Label text="OFFRE"
                       style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-weight: 700;"/>
                <Label fx:id="lblInfoOffre" text="—"
                       style="-fx-font-size: 13px; -fx-text-fill: #60A5FA; -fx-font-weight: 700;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- BANDE DÉGRADÉE ACCENT -->
    <Region prefHeight="4"
            style="-fx-background-color: linear-gradient(to right, #F97316, #2563EB);"/>

    <!-- CORPS DU FORMULAIRE -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: white; -fx-background: white;
                       -fx-border-color: transparent;">
        <VBox spacing="18" style="-fx-background-color: white;">
            <padding><Insets top="25" right="35" bottom="10" left="35"/></padding>

            <!-- DATE -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Date de l'entretien"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E3A5F;"/>
                    <Label text="*" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;"/>
                </HBox>
                <DatePicker fx:id="dateEntretien" prefWidth="470"
                            promptText="Sélectionnez une date"
                            style="-fx-font-size: 13px; -fx-border-color: #E2E8F0;
                                   -fx-border-radius: 10; -fx-background-radius: 10;
                                   -fx-border-width: 1.5;"/>
            </VBox>

            <!-- HEURES -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Heure début"
                               style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E3A5F;"/>
                        <Label text="*" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;"/>
                    </HBox>
                    <TextField fx:id="heureDebut" promptText="14:30"
                               style="-fx-font-size: 13px; -fx-border-color: #E2E8F0;
                                      -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-border-width: 1.5; -fx-padding: 9 12;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Heure fin"
                               style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E3A5F;"/>
                        <Label text="*" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;"/>
                    </HBox>
                    <TextField fx:id="heureFin" promptText="15:30"
                               style="-fx-font-size: 13px; -fx-border-color: #E2E8F0;
                                      -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-border-width: 1.5; -fx-padding: 9 12;"/>
                </VBox>
            </HBox>

            <!-- TYPE ENTRETIEN -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Type d'entretien"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E3A5F;"/>
                    <Label text="*" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;"/>
                </HBox>
                <ComboBox fx:id="typeEntretien" prefWidth="470"
                          promptText="Choisissez le type"
                          style="-fx-font-size: 13px; -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 10; -fx-background-radius: 10;
                                 -fx-border-width: 1.5;"/>
            </VBox>

            <!-- SÉPARATEUR -->
            <Separator style="-fx-background-color: #EFF3FB; -fx-opacity: 0.8;"/>

            <!-- LIEU -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Lieu (si présentiel)"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E3A5F;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="lieu"
                               promptText="Cliquez sur le bouton carte pour choisir le lieu..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-font-size: 13px; -fx-border-color: #E2E8F0;
                                      -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-border-width: 1.5; -fx-padding: 9 12;"/>
                    <Button text="Vérifier"
                            onAction="#validerAdresse"
                            prefHeight="38" prefWidth="85"
                            style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569;
                                   -fx-font-size: 11.5px; -fx-font-weight: 700;
                                   -fx-background-radius: 10; -fx-cursor: hand;
                                   -fx-border-color: #E2E8F0; -fx-border-radius: 10;
                                   -fx-border-width: 1.5;"/>
                </HBox>
                <Button fx:id="btnChoisirSurCarte"
                        text="🗺️ Choisir le lieu sur la carte (OpenStreetMap)"
                        onAction="#ouvrirLocationPicker"
                        prefWidth="470" prefHeight="42"
                        disable="true"
                        style="-fx-background-color: linear-gradient(135deg, #1A6BFF, #0E54CC);
                               -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700;
                               -fx-background-radius: 11px; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(26,107,255,0.35), 10, 0, 0, 3);"/>
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-background-color: #EFF6FF; -fx-background-radius: 8px;
                             -fx-padding: 7 12 7 12;">
                    <Label text="ℹ"
                           style="-fx-font-size: 12px; -fx-font-weight: 900; -fx-text-fill: #2563EB;
                                  -fx-background-color: #BFDBFE; -fx-background-radius: 50%;
                                  -fx-min-width: 18; -fx-min-height: 18; -fx-alignment: CENTER;"/>
                    <Label text="Sélectionnez 'présentiel' pour activer le sélecteur de lieu sur la carte."
                           style="-fx-font-size: 11px; -fx-text-fill: #2563EB; -fx-wrap-text: true;"
                           wrapText="true" prefWidth="380"/>
                </HBox>
            </VBox>

            <!-- LIEN VISIO -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Lien Visioconférence (si visio)"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E3A5F;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="lienVisio"
                               promptText="Généré automatiquement via Google Meet"
                               HBox.hgrow="ALWAYS"
                               style="-fx-font-size: 12px; -fx-border-color: #E2E8F0;
                                      -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-border-width: 1.5; -fx-padding: 9 12;"/>
                    <Button fx:id="btnGenererMeet"
                            text="📹 Meet"
                            onAction="#genererLienMeet"
                            prefHeight="38" prefWidth="80"
                            style="-fx-background-color: #2563EB; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: 700;
                                   -fx-background-radius: 10; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian,rgba(37,99,235,0.35),8,0,0,2);"/>
                </HBox>
            </VBox>

            <!-- SÉPARATEUR -->
            <Separator style="-fx-background-color: #EFF3FB; -fx-opacity: 0.8;"/>

            <!-- STATUT -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Statut de l'entretien"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E3A5F;"/>
                    <Label text="(automatique)"
                           style="-fx-font-size: 11px; -fx-text-fill: #94A3B8; -fx-font-style: italic;"/>
                </HBox>
                <ComboBox fx:id="statut" prefWidth="470"
                          style="-fx-font-size: 13px; -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 10; -fx-background-radius: 10;
                                 -fx-border-width: 1.5; -fx-opacity: 0.7;"/>
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-background-color: #EFF6FF; -fx-background-radius: 8px;
                             -fx-padding: 8 12 8 12;">
                    <Label text="Le statut est géré automatiquement selon les actions du candidat."
                           style="-fx-font-size: 11px; -fx-text-fill: #2563EB; -fx-wrap-text: true;"
                           wrapText="true" prefWidth="420"/>
                </HBox>
            </VBox>

            <!-- NOTE RECRUTEUR -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Note interne (optionnel)"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E3A5F;"/>
                </HBox>
                <TextField fx:id="noteRecruteur"
                           promptText="Ex: Candidat très motivé, bonne expérience..."
                           style="-fx-font-size: 13px; -fx-border-color: #E2E8F0;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-border-width: 1.5; -fx-padding: 9 12;"/>
            </VBox>

            <Region prefHeight="8"/>
        </VBox>
    </ScrollPane>

    <!-- FOOTER — BOUTON ENREGISTRER -->
    <VBox style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                 -fx-border-width: 1 0 0 0; -fx-padding: 16 35 20 35;"
          spacing="10">
        <Label text="* Champs obligatoires"
               style="-fx-font-size: 11px; -fx-text-fill: #94A3B8; -fx-font-style: italic;"/>
        <Button text="✅ Enregistrer l'entretien"
                onAction="#save"
                prefHeight="48" prefWidth="470"
                style="-fx-background-color: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
                       -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 800;
                       -fx-background-radius: 12px; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.45), 14, 0, 0, 5);"/>
    </VBox>
</VBox>
